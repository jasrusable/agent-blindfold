#!/usr/bin/env python3
"""Launcher that runs blindfold from this checkout without installing it.

If blindfold itself can't be imported (a broken checkout or Python), `hook`
falls back to a stdlib-only fail-closed reply: tool output withheld, calls
refused, prompts blocked, the turn stopped before the model reads output it
couldn't withhold. A crashing hook would otherwise fail open."""

import json
import os
import sys

WITHHELD = "<blindfold: output withheld because blindfold is broken; ask the user to run `blindfold doctor`>"


def _withhold(value):
    if isinstance(value, str):
        return WITHHELD
    if isinstance(value, list):
        return [_withhold(item) for item in value]
    if isinstance(value, dict):
        return {key: _withhold(item) for key, item in value.items()}
    return value


BROKEN = "blindfold is broken (it could not load), so it fails closed. Run `blindfold doctor` and fix what it reports."


def fallback_hook():
    print("blindfold: could not load, so it is running in fail-safe mode; run `blindfold doctor`", file=sys.stderr)
    try:
        raw = json.loads(sys.stdin.buffer.read())
        name = raw.get("hook_event_name") or raw.get("hookEventName")
    except Exception:  # noqa: BLE001
        return 2
    if name in ("PostToolUse", "PostToolUseFailure", "post_tool_use"):
        key = next((k for k in raw if any(h in k.lower() for h in ("response", "result", "output"))), None)
        reply = {"hookSpecificOutput": {"hookEventName": raw.get("hook_event_name", name), "additionalContext": WITHHELD}}
        if key is not None:
            reply["hookSpecificOutput"]["updatedToolOutput"] = _withhold(raw[key])
        sys.stdout.write(json.dumps(reply, ensure_ascii=True))
    elif name in ("PreToolUse", "pre_tool_use"):
        reply = {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": "blindfold: " + BROKEN}}
        sys.stdout.write(json.dumps(reply, ensure_ascii=True))
    elif name in ("UserPromptSubmit", "PostToolBatch", "user_prompt_submit"):
        # PostToolBatch: Claude can't replace a failed call's output, so stop
        # the turn before the model reads it.
        sys.stdout.write(json.dumps({"decision": "block", "reason": "⚠️ " + BROKEN}, ensure_ascii=True))
    elif name == "SessionStart":
        sys.stdout.write(json.dumps({"systemMessage": "⚠️ " + BROKEN}, ensure_ascii=True))
    return 0


sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

try:
    from blindfold.cli import main
except Exception:  # noqa: BLE001 - a broken install must not fail open
    if sys.argv[1:2] != ["hook"]:
        raise
    main = fallback_hook

sys.exit(main())
