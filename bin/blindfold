#!/usr/bin/env python3
"""Launcher that runs blindfold from this checkout without installing it.

If blindfold itself can't be imported (a broken checkout or Python), `hook`
falls back to a stdlib-only reply that withholds tool output, since a crashing
hook fails open in both agents."""

import json
import os
import sys

WITHHELD = "<blindfold: output withheld because blindfold is broken; ask the user to run `blindfold doctor`>"


def _withhold(value):
    if isinstance(value, str):
        return WITHHELD
    if isinstance(value, list):
        return [_withhold(item) for item in value]
    if isinstance(value, dict):
        return {key: _withhold(item) for key, item in value.items()}
    return value


def fallback_hook():
    print("blindfold: could not load, so it is running in fail-safe mode; run `blindfold doctor`", file=sys.stderr)
    try:
        raw = json.loads(sys.stdin.buffer.read())
        name = raw.get("hook_event_name") or raw.get("hookEventName")
    except Exception:  # noqa: BLE001
        return 2
    if name in ("PostToolUse", "PostToolUseFailure", "post_tool_use"):
        key = next((k for k in raw if any(h in k.lower() for h in ("response", "result", "output"))), None)
        reply = {"hookSpecificOutput": {"hookEventName": raw.get("hook_event_name", name), "additionalContext": WITHHELD}}
        if key is not None:
            reply["hookSpecificOutput"]["updatedToolOutput"] = _withhold(raw[key])
        if name == "PostToolUseFailure":
            reply["systemMessage"] = "⚠️ blindfold is broken and can't mask failed tool calls; their output may have reached the model."
        sys.stdout.write(json.dumps(reply, ensure_ascii=True))
    elif name in ("UserPromptSubmit", "SessionStart"):
        sys.stdout.write(json.dumps({"systemMessage": "⚠️ blindfold is broken (run `blindfold doctor`): tool output is withheld, prompts are unchecked."}))
    return 0


sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

try:
    from blindfold.cli import main
except Exception:  # noqa: BLE001 - a broken install must not fail open
    if sys.argv[1:2] != ["hook"]:
        raise
    main = fallback_hook

sys.exit(main())
